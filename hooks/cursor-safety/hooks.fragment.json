{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "node .cursor/hooks/mark-gate-needed.mjs",
        "matcher": "Write|StrReplace"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/deny-destructive-git.mjs"
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/redact-env-read.mjs"
      }
    ],
    "beforeTabFileRead": [
      {
        "command": "node .cursor/hooks/redact-env-read.mjs"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/remind-gate.mjs",
        "loop_limit": 1
      }
    ]
  }
}
